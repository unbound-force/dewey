{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unbound-force/unbound-force/schemas/review-matrix/v2.schema.json",
  "title": "Review Matrix Version 2",
  "description": "Closed policy input for explicit-first Divisor review dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles",
    "defaults"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/profileName"
      },
      "required": [
        "lightweight",
        "standard",
        "heavy"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "spec",
        "triage",
        "feedback"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/profileName"
        },
        "spec": {
          "$ref": "#/$defs/profileName"
        },
        "triage": {
          "$ref": "#/$defs/profileName"
        },
        "feedback": {
          "$ref": "#/$defs/profileName"
        }
      }
    },
    "always": {
      "$ref": "#/$defs/agentProfileMap"
    },
    "advisor": {
      "$ref": "#/$defs/advisorModes"
    },
    "runs": {
      "$ref": "#/$defs/runModes"
    },
    "risk_augmentation": {
      "$ref": "#/$defs/riskAugmentation"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "profileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "agentName": {
      "type": "string",
      "pattern": "^divisor-[a-z0-9-]{1,63}$"
    },
    "model": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "variant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/model"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "agentArray": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/agentName"
      }
    },
    "agentProfileMap": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/agentName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profileName"
      }
    },
    "advisorModes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agentArray"
        },
        "spec": {
          "$ref": "#/$defs/agentArray"
        },
        "triage": {
          "$ref": "#/$defs/agentArray"
        },
        "feedback": {
          "$ref": "#/$defs/agentArray"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/profileName"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        }
      },
      "oneOf": [
        {
          "required": [
            "profile"
          ],
          "not": {
            "required": [
              "model"
            ]
          }
        },
        {
          "required": [
            "model"
          ],
          "not": {
            "required": [
              "profile"
            ]
          }
        }
      ]
    },
    "agentRuns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "agentRunMap": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/agentName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agentRuns"
      }
    },
    "runModes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agentRunMap"
        },
        "spec": {
          "$ref": "#/$defs/agentRunMap"
        },
        "triage": {
          "$ref": "#/$defs/agentRunMap"
        },
        "feedback": {
          "$ref": "#/$defs/agentRunMap"
        }
      }
    },
    "riskAugmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "agents"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agents": {
          "$ref": "#/$defs/agentArray"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_personas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 16
        },
        "max_runs_per_persona": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "max_total_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 24
        },
        "max_parallel_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 4
        },
        "per_run_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800,
          "default": 600
        },
        "max_reported_cost_usd": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    }
  }
}
