{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dewey": {
      "type": "local",
      "command": [
        "dewey",
        "serve",
        "--vault",
        "."
      ],
      "enabled": true
    },
    "replicator": {
      "type": "local",
      "command": [
        "replicator",
        "serve"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./.opencode/plugins/invoke-agent/index.ts",
    "./.opencode/plugins/review-dispatch/index.ts",
    "./.opencode/plugins/uf-workflow/index.ts",
    "./.opencode/plugins/uf-finale/index.ts"
  ]
}
