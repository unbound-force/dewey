{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unbound-force/unbound-force/schemas/lesson-proposal/v1.0.0.schema.json",
  "title": "Source-Grounded Lesson Proposal Version 1.0.0",
  "description": "Closed child-review proposal for one quarantined, source-grounded lesson.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sibling",
    "commit",
    "sources",
    "information"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "sibling": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "information": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "excerpt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
