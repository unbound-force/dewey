      }
    },
    "workflowResult": {
      "oneOf": [
        { "$ref": "#/$defs/councilResult" },
        { "$ref": "#/$defs/triageResult" },
        { "$ref": "#/$defs/feedbackResult" },
        { "$ref": "#/$defs/testReviewResult" }
      ]
    }
  }
}
